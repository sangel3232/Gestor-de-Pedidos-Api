<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ============================================================
         003 - Tabla de auditoría para cambios de estado en pedidos
         ============================================================ -->

    <changeSet id="003-1" author="sergio" dbms="postgresql">
        <comment>Crear tipo ENUM para operaciones de auditoría</comment>
        <sql>
            DO $$ BEGIN
                IF NOT EXISTS (SELECT 1 FROM pg_type WHERE typname = 'operacion_auditoria') THEN
                    CREATE TYPE operacion_auditoria AS ENUM ('INSERT', 'UPDATE', 'DELETE');
                END IF;
            END $$;
        </sql>
        <rollback>
            DROP TYPE IF EXISTS operacion_auditoria;
        </rollback>
    </changeSet>

    <changeSet id="003-2" author="sergio">
        <comment>Crear tabla pedido_auditoria</comment>
        <createTable tableName="pedido_auditoria">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pedido_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="estado_anterior" type="VARCHAR(20)"/>
            <column name="estado_nuevo"    type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="total_anterior"  type="NUMERIC(12,2)"/>
            <column name="total_nuevo"     type="NUMERIC(12,2)"/>
            <column name="operacion"       type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="modificado_en"   type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="modificado_por"  type="VARCHAR(100)" defaultValue="system"/>
        </createTable>
        <rollback>
            <dropTable tableName="pedido_auditoria"/>
        </rollback>
    </changeSet>

    <changeSet id="003-3" author="sergio">
        <comment>Índices sobre tabla pedido_auditoria</comment>
        <createIndex indexName="idx_auditoria_pedido_id" tableName="pedido_auditoria">
            <column name="pedido_id"/>
        </createIndex>
        <createIndex indexName="idx_auditoria_fecha" tableName="pedido_auditoria">
            <column name="modificado_en" descending="true"/>
        </createIndex>
        <rollback>
            <dropIndex indexName="idx_auditoria_pedido_id" tableName="pedido_auditoria"/>
            <dropIndex indexName="idx_auditoria_fecha"     tableName="pedido_auditoria"/>
        </rollback>
    </changeSet>

    <changeSet id="003-4" author="sergio">
        <comment>Crear tabla cliente_auditoria para rastrear cambios en clientes</comment>
        <createTable tableName="cliente_auditoria">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="cliente_id"   type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="nombre_anterior"  type="VARCHAR(100)"/>
            <column name="nombre_nuevo"     type="VARCHAR(100)"/>
            <column name="email_anterior"   type="VARCHAR(150)"/>
            <column name="email_nuevo"      type="VARCHAR(150)"/>
            <column name="activo_anterior"  type="BOOLEAN"/>
            <column name="activo_nuevo"     type="BOOLEAN"/>
            <column name="operacion"        type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="modificado_en"    type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="cliente_auditoria"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
